{
	"name": "zephyr",
	"version": "1.3.2",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"lint:fix": "prettier --write --list-different .",
		"tauri": "tauri",
		"start": "tauri dev",
		"machine-translate": "inlang machine translate --project project.inlang",
		"tauri:build": "tauri build",
		"tauri:build:appimage": "tauri build && ./appimage-build/post_build_fix.sh",
		"tauri:build:complete": "./appimage-build/build_and_fix.sh",
		"tauri:appimage:generate": "./appimage-build/generate_appimage.sh",
		"tauri:appimage:fix": "./appimage-build/post_build_fix.sh",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@iconify/svelte": "^5.2.1",
		"@inlang/cli": "^3.1.11",
		"@inlang/paraglide-js": "2.18.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tailwindcss/vite": "^4.2.4",
		"@tauri-apps/cli": "^2.11.1",
		"@types/node": "^25.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"tailwindcss-palette-generator": "^0.10.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"vitest": "^2.1.9"
	},
	"type": "module",
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.2",
			"esbuild": "^0.25.0"
		}
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-deep-link": "^2.4.9",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-http": "^2.5.9",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@tauri-apps/plugin-window-state": "^2.4.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"highlight.js": "^11.11.1",
		"js-convert-case": "^4.2.0",
		"marked": "^17.0.6",
		"posthog-js": "^1.372.9",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"runed": "^0.29.2",
		"svelte-exmarkdown": "^5.0.2"
	}
}
